# Discord Bot Configuration
# Obtain these credentials from the Discord Developer Portal:

# Bot Token (Bot tab -> "Reset Token")
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Bot Client ID / Application ID (General Information tab)
CLIENT_ID=YOUR_CLIENT_ID_HERE

# (Optional) Your first / main server's ID (Developer Mode -> right click server -> Copy Server ID).
# Not needed for the bot to work on a server. Used by COMMAND_MODE=server and as the panel's default server.
GUILD_ID=

# How slash commands are registered (the bot does it on every start):
#   global  (default) one list for all servers; commands of a module that is off answer "turned off"
#   server            each server gets its own list; commands of modules that are off are hidden
COMMAND_MODE=global

# (Optional) Your Discord user ID(s) for owner-only commands like /info and /note.
# Comma-separated. If empty, only the server owner can use them.
OWNER_IDS=

# (Optional) Admin API for the desktop panel. It listens on 127.0.0.1 only; the panel reaches it
# through an SSH tunnel. Leave the token empty to turn the API off.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=
ADMIN_API_PORT=7410

# (Optional) Stream alerts: Twitch and Kick need a free app each (Client ID + Secret).
# They can also be entered in the desktop panel (Streams), which wins over these. YouTube needs nothing.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
